{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolResult — proposed common envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "status": {
      "enum": [
        "OK",
        "ERROR",
        "NEEDS_INFORMATION"
      ]
    },
    "result_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "snapshot_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "object",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calculation_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            },
            "safe_message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "safe_message",
            "retryable"
          ]
        }
      ]
    }
  },
  "required": [
    "status",
    "result_id",
    "snapshot_id",
    "result",
    "evidence_refs",
    "warnings",
    "missing_fields",
    "calculation_version",
    "error"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ERROR"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "OK"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          }
        }
      }
    }
  ]
}