{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DomainEvent — proposed envelope",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "event_type": {
      "type": "string",
      "minLength": 3
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_id",
    "aggregate_version",
    "occurred_at",
    "observed_at",
    "correlation_id",
    "causation_id",
    "payload"
  ]
}