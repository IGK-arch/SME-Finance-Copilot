# Generated by deploy/install.sh. __DOMAIN__ is replaced with your domain.
# Caddy obtains and renews the Let's Encrypt certificate automatically.
__DOMAIN__ {
	encode zstd gzip

	# Largest legitimate request: a 1 MB CSV/XLSX import as base64 JSON.
	request_body {
		max_size 2MB
	}

	# Development-only and internal endpoints are never public.
	@internal path /legacy /legacy/* /hooks/*
	respond @internal 404

	reverse_proxy 127.0.0.1:8080 {
		# Model runs can take up to MODEL_MAX_ELAPSED_SECONDS.
		transport http {
			read_timeout 300s
		}
	}
}

www.__DOMAIN__ {
	redir https://__DOMAIN__{uri} permanent
}
