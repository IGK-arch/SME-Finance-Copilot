# /etc/sme-copilot/sme-copilot.env  (owner root, group sme, mode 0640)
# Exact public https origin of the cabinet. Must match the domain in the Caddyfile.
SME_PUBLIC_ORIGIN=https://__DOMAIN__

# Product safety switches (startup refuses anything else).
DATA_MODE=synthetic
EXECUTION_BACKEND=sandbox
ALLOW_REAL_FINANCIAL_ACTIONS=false
ALLOW_EXTERNAL_NOTIFICATIONS=false
ALLOW_UNAPPROVED_DATA_EGRESS=false

# Optional reviewer demo: the public sign-in page shows this role's token from the
# workspace login file (OWNER, ACCOUNTANT or AUDITOR; ADMIN is refused at startup).
# Anyone who opens the site can then sign in with it. Synthetic data only.
#SME_DEMO_LOGIN_ROLE=OWNER

# ---- Model -------------------------------------------------------------------
# Default: deterministic offline MOCK. Nothing leaves the server.
MODEL_PROVIDER=mock

# LIVE (Strata via the SSH bridge on this server): comment the line above,
# uncomment the block below, set the bridge token, start sme-strata-bridge first.
#MODEL_PROVIDER=strata
#MODEL_NAME=qwen3.8-flash-next-iq3_xxs
#MODEL_BASE_URL=http://127.0.0.1:18443
#ALLOW_SERVER_MODEL_INFERENCE=true
#SME_MODEL_SECRET=<bridge_token from /etc/sme-copilot/strata/bridge.secret.json>
#MODEL_TIMEOUT_SECONDS=120
#MODEL_MAX_ELAPSED_SECONDS=240
#MODEL_CONTEXT_TOKENS=16384
#MODEL_OUTPUT_TOKENS=2048
