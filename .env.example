DATA_MODE=synthetic
EXECUTION_BACKEND=sandbox
MODEL_PROVIDER=mock
MODEL_NAME=
MODEL_BASE_URL=http://127.0.0.1:11434
ALLOW_LOCAL_MODEL_INFERENCE=false
ALLOW_SERVER_MODEL_INFERENCE=false
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_ELAPSED_SECONDS=240
MODEL_CONTEXT_TOKENS=8192
MODEL_OUTPUT_TOKENS=1024
ALLOW_REAL_FINANCIAL_ACTIONS=false
ALLOW_EXTERNAL_NOTIFICATIONS=false
ALLOW_UNAPPROVED_DATA_EGRESS=false
# Optional local secrets are supplied by the shell, never committed:
# SME_MODEL_SECRET=
# Strata over an authenticated SSH bridge: MODEL_PROVIDER=strata,
# MODEL_BASE_URL=http://127.0.0.1:18443, exact MODEL_NAME, and
# ALLOW_SERVER_MODEL_INFERENCE=true. See docs/runbooks/strata.md.
# SME_WEBHOOK_SECRET=
# SME_POSTGRES_TEST_CONFIG=.runtime/postgres/cluster.secret.json
# This file is documentation; startup does not automatically load dotenv.
